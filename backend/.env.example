NODE_ENV=development
PORT=5001

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/pulse-board

# JWT signing — MUST be 32+ chars (use `openssl rand -hex 32`)
JWT_SECRET=replace-me-with-a-long-random-string-32-chars-min
# Short-lived access token TTL (ms/s/m/h/d notation per `jsonwebtoken`)
ACCESS_TOKEN_TTL=15m
# Refresh token (httpOnly cookie) lifetime in days
REFRESH_TOKEN_TTL_DAYS=30

# Google OAuth (authorization-code flow — both values required for Google sign-in)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Comma-separated list of allowed origins for HTTP + Socket.IO
CORS_ORIGINS=http://localhost:5173,https://pulse-board-mauve.vercel.app

# Cookie behaviour. Leave unset to auto-derive from NODE_ENV:
#   production  -> secure=true,  sameSite=none  (cross-domain deployments)
#   development -> secure=false, sameSite=lax
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none

# SMTP / SendGrid (transactional email)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
EMAIL_FROM="PulseBoard Auth" <noreply@yourdomain.com>

# Optional: explicit SendGrid API key (otherwise falls back to SMTP_PASS)
# SENDGRID_API_KEY=

# Optional timeouts (ms)
# SENDGRID_API_TIMEOUT_MS=15000
# SMTP_SEND_TIMEOUT_MS=12000
